# --- Required ---
CONNECTOR_SECRET=paste-output-of-openssl-rand-hex-32

# --- Safety ---
MAX_DAILY_BUDGET=100
ADS_READ_ONLY=false

# --- Meta (Facebook/Instagram) ---
META_ACCESS_TOKEN=
META_API_VERSION=v23.0

# --- Google Ads ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21

# --- Reels ---
# Public https address of this server, used for reel video links Meta downloads.
# On Render this is filled in automatically (RENDER_EXTERNAL_URL); set it for a custom domain.
PUBLIC_URL=
MEDIA_RETENTION_DAYS=14

# --- Voiceovers (ElevenLabs) ---
ELEVENLABS_API_KEY=
# Optional: voices in rotation (names zara, brielle, lyan or ElevenLabs voice IDs, comma-separated)
ELEVENLABS_VOICE_IDS=
# Optional: model (default eleven_v4)
ELEVENLABS_MODEL=
